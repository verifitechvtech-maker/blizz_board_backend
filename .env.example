# ===== Copy this file to .env and fill in your own values (never commit .env) =====

# ---- Server ----
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/taskmanagement
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d

# Public URL of the frontend (email links) — also allowed by CORS
# Extra allowed frontend origins, comma separated (optional)
CORS_ORIGINS=

# ---- Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Blizz Board
MAIL_FROM_EMAIL=

# ---- Time zone for meetings and task reminders ----
MEETING_TIME_ZONE=Asia/Kolkata
MEETING_REMINDER_MINUTES=15

# ---- Google (optional: Calendar / Meet) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=https://<your-backend>/oauth2callback


# Public URL of the frontend — used in verification email links
FRONTEND_URL=http://localhost:5173
# Optional: key for the short-lived encrypted password (defaults to one derived from JWT_SECRET)
# CREDENTIAL_SECRET=

# Web Push — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# MoM video calls (built-in WebRTC)
# Public address of the frontend — used in the meeting links emailed to attendees (use https outside localhost)
FRONTEND_URL=http://localhost:5173
# The link opens this many minutes before the start, and closes this many minutes after the end
MEETING_JOIN_EARLY_MINUTES=15
MEETING_JOIN_LATE_MINUTES=30
# People per call (each browser connects to every other one)
MEETING_MAX_PARTICIPANTS=8
# STUN: Google's free public servers are used when this is empty
STUN_URLS=
# TURN (relay for strict firewalls / mobile data). Google has no public TURN — run coturn
# (see deploy/turnserver.conf.example) or use a TURN provider.
TURN_URLS=
# coturn "use-auth-secret": the backend makes short-lived passwords per user (recommended)
TURN_SECRET=
TURN_TTL_SECONDS=43200
# …or one fixed login from a TURN provider
TURN_USERNAME=
TURN_CREDENTIAL=
# true = send every call through TURN
WEBRTC_FORCE_RELAY=false

# Optional: whisper.cpp server for the video-call transcript (the engine Meetily is built on).
# Build https://github.com/ggml-org/whisper.cpp, download a model, then run e.g.:
#   ./build/bin/whisper-server -m models/ggml-base.en.bin --host 127.0.0.1 --port 8178
# Empty = the built-in Whisper worker is used.
WHISPER_SERVER_URL=

# Telegram bot — create one with @BotFather in Telegram and paste its token here.
# Empty = the bot is off. Users connect it from Settings → Notifications → Telegram.
TELEGRAM_BOT_TOKEN=
# Optional: where the bot reaches this API (default http://127.0.0.1:<PORT>)
# TELEGRAM_INTERNAL_API_URL=

# ---- Cloudinary file storage (task, Task Bank, chat and meeting files; max 8 MB each) ----
# Leave empty to keep files on the server disk. Meeting recordings always stay on disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# optional: top folder in your Cloudinary media library
CLOUDINARY_FOLDER=task-management

# ---- Create tasks by email ----
# People email this address: Subject = title, To/CC = assignees, body = description
# (optional lines "Due: 15 Nov 2026 5:00 PM", "Priority: High", "Department: ...", "Assign: ...").
# With Gmail, use a "+" address of the mailbox below, e.g. yourname+tasks@gmail.com
TASK_INBOX_ENABLED=false
TASK_INBOX_ADDRESS=
# IMAP login of the mailbox that receives it (defaults: imap.gmail.com:993, SMTP_USER / SMTP_PASS)
TASK_INBOX_IMAP_HOST=imap.gmail.com
TASK_INBOX_IMAP_PORT=993
TASK_INBOX_USER=
TASK_INBOX_PASS=
# Only accept senders that pass SPF/DKIM/DMARC (keep true in production)
TASK_INBOX_REQUIRE_AUTH=true

# ---- First SuperAdmin (only used by: node src/utils/seedSuperAdmin.js) ----
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
